# Backend environment for non-docker runs (`make backend` reads the root .env instead).
# SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/general_cms
SPRING_DATASOURCE_USERNAME=general_cms
SPRING_DATASOURCE_PASSWORD=general_cms

# Admin sign-in (bcrypt hash of the password — see the root README) and token signing key.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# Session length (Spring duration format)
JWT_TTL=8h

# Where uploaded images are stored on disk
MEDIA_STORAGE_DIR=./data/media
