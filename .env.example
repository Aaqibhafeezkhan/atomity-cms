# Used by docker-compose.yml. Copy to .env and adjust. Never commit .env.
# Every value below is a safe local default; nothing here points at Atomity infrastructure.
POSTGRES_DB=general_cms
POSTGRES_USER=general_cms
POSTGRES_PASSWORD=general_cms

# Admin sign-in. The password is stored only as a bcrypt hash; generate one with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'your-password' | tr -d ':\n'
# Keep the single quotes: the hash contains "$", which Compose would otherwise expand.
# The values below sign you in as admin@example.com / admin. Local use only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$10$wBISilJqYrK8S7ddSh4zhuWUnPjn24l5hToR4l4lIkKH/WG.fsKI6'

# Signs session tokens; at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=local-development-secret-not-for-production-use

# Host ports (same defaults as Blog CMS: stop that stack first or change these)
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
CONSUMER_PORT=4000

# Only for `make demo`: the password of ADMIN_EMAIL (the default hash above is the hash of "admin").
SEED_ADMIN_PASSWORD=admin

# Session cookie HTTPS-only flag. Keep false for this plain-HTTP stack; true behind HTTPS.
SESSION_COOKIE_SECURE=false
